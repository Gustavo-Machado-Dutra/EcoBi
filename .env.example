# Configuração Local — EcoBI Intelligence
# Nunca envie dados ou tokens empresariais para APIs externas.

ECOBI_ENV=local
ECOBI_HOST=127.0.0.1
ECOBI_PORT=8000
ECOBI_DB_PATH=data/runtime/ecobi.db
ECOBI_DATA_DIR=data/runtime
ECOBI_EXPORTS_DIR=data/powerbi_exports

# Orçamento estrito de memória RAM (MB) — máximo 8 GB (8192 MB)
ECOBI_MAX_RAM_MB=8192
ECOBI_CSV_CHUNK_SIZE=10000

# Ollama Local (sem APIs externas de IA)
ECOBI_OLLAMA_URL=http://127.0.0.1:11434
ECOBI_DEFAULT_MODEL=qwen3.5:4b
ECOBI_ADVANCED_MODEL=qwen3.5:9b
ECOBI_LLM_NUM_CTX=4096
ECOBI_LLM_KEEP_ALIVE=5m
ECOBI_LLM_TIMEOUT_SECONDS=60

# Segurança, Privacidade e LGPD
# Defina uma chave/salt local forte para tokens e pseudonimização em produção local
ECOBI_LOCAL_SECRET=ecobi-local-dev-change-in-production
ECOBI_DEFAULT_RETENTION_DAYS=365
ECOBI_MASK_PII=true
ECOBI_BLOCK_EXTERNAL_AI=true
